# Токен від @BotFather
BOT_TOKEN=

# Випадковий рядок (openssl rand -hex 24). Telegram шле його в заголовку кожного вебхука.
WEBHOOK_SECRET=

# Випадковий рядок. Ним зовнішній cron (cron-job.org) авторизується на /api/cron/reminders
CRON_SECRET=

# Neon Postgres connection string (з ?sslmode=require)
DATABASE_URL=

# Публічна адреса застосунку, без слеша в кінці. Локально — адреса тунелю (ngrok / cloudflared).
APP_URL=https://your-app.vercel.app

# Твій Telegram user id — має повні права завжди, незалежно від адмінів групи.
OWNER_TELEGRAM_ID=

# Тільки для локальної розробки: відкривати Mini App у звичайному браузері без Telegram
# від імені цього користувача (буде адміном). У продакшні ігнорується.
DEV_TELEGRAM_USER_ID=
